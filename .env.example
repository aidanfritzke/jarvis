# Copy to .env (gitignored). Used by docker-compose.
# The server's own Tailscale IP — Caddy binds ONLY to this, so Jarvis is reachable on the
# tailnet and nowhere else. Find it with: tailscale ip -4
HOST_TS_IP=100.x.y.z

# Absolute host path to your notes vault, bind-mounted into the agent as /srv/notes.
# Defaults to /srv/notes (what DEPLOY.md step 2 creates) if unset.
NOTES_PATH=/srv/notes
